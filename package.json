{
  "name": "vanta-drive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-booking.mjs",
    "test:ui": "node scripts/check-ui.mjs && node scripts/check-journeys.mjs",
    "test:layout": "node scripts/browser-qa.mjs && node scripts/check-quality.mjs",
    "format:check": "oxfmt --check",
    "check": "npm run typecheck && npm run lint && npm test",
    "assets:prepare": "node scripts/prepare-images.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "framer-motion": "^12.43.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260907.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.58.2",
    "sharp": "0.35.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "type": "module",
  "description": "Premium vehicle rental portfolio with catalog filters and a booking flow."
}
